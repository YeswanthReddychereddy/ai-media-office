{
  "name": "ai-media-office",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "python3 scripts/secret_scan.py"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "better-sqlite3": "^12.10.0",
    "@xyflow/react": "^12.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.577.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@playwright/test": "^1.58.2"
  }
}
