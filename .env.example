# Optional local settings. Never put credentials in Git.
DATABASE_PATH=./data/company.sqlite
CHECKPOINT_PATH=./data/checkpoints.sqlite
# Set a long random passphrase to require Founder sign-in.
FOUNDER_PASSWORD=
# Used only when FOUNDER_PASSWORD is set; use at least 32 random characters.
SESSION_SECRET=
# Demo needs no model or paid API. Optional local Ollama chat adapter:
TEXT_PROVIDER=demo
PRODUCTION_PROVIDER=demo
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Node worker delay between demo steps; leave enough time to watch handoffs.
WORKER_STEP_MS=2200
